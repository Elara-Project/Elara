# Copie para .env e preencha. O .env NUNCA vai pro Git.

# Banco (XAMPP padrão: usuário root, sem senha)
DATABASE_URL="mysql://root:@localhost:3306/tea_cuidar"

# Assinatura do token de login — use uma string longa e aleatória
JWT_SECRET="troque_por_uma_string_longa_e_aleatoria"

# Chave do Gemini (aistudio.google.com/app/apikey) — necessária para o assistente de IA
GEMINI_API_KEY=""

# Origem do front liberada no CORS (padrão: http://localhost:3000)
WEB_ORIGIN="http://localhost:3000"

# Porta da API (padrão: 3001, porque o front usa a 3000)
PORT=3001

# Opcional: pasta dos uploads. Vazio = apps/api/uploads (ver docs/uploads-dir.txt)
UPLOAD_DIR=""
